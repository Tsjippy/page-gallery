{
	"schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tsjippy-page-gallery/show",
	"version": "0.1.0",
	"title": "Page gallery",
	"category": "widgets",
	"description": "A dynamic gallery of pages",
	"textdomain": "tsjippy",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"usesContext": [ "postType" ],
	"attributes": {
		"postTypes": {
			"type": "array",
			"default": []
		},
		"amount": {
			"type": "integer",
			"default": 10
		},
		"categories": {
			"type": "array",
			"default": []
		},
		"speed": {
			"type": "integer",
			"default": 3
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"color": {
			"type": "string",
			"default": ""
		},
		"gradient": {
			"type": "boolean",
			"default": false
		}
	}
}
